---
interface Props {
  variant?: 'gold' | 'iznik' | 'garnet' | 'neutral';
  class?: string;
}
const { variant = 'neutral', class: cls = '' } = Astro.props;
const variantClass = {
  gold: 'chip-gold',
  iznik: 'chip-iznik',
  garnet: 'chip-garnet',
  neutral: 'chip-neutral',
}[variant];
---

<span class={`chip ${variantClass} ${cls}`}>
  <slot />
</span>
