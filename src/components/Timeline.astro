---
import type { CollectionEntry } from 'astro:content';
import AttractionCard from '@/components/AttractionCard.astro';

interface Props {
  stops: CollectionEntry<'attractions'>[];
  color: string;
}

const { stops, color } = Astro.props;

type Slot = { label: string; items: CollectionEntry<'attractions'>[] };

function groupStops(stops: CollectionEntry<'attractions'>[]): Slot[] {
  const n = stops.length;
  if (n === 0) return [];
  if (n === 1) return [{ label: 'Giornata', items: stops }];
  if (n === 2) return [{ label: 'Mattino', items: [stops[0]] }, { label: 'Pomeriggio', items: [stops[1]] }];
  if (n === 3) {
    return [
      { label: 'Mattino', items: [stops[0]] },
      { label: 'Pomeriggio', items: [stops[1]] },
      { label: 'Sera', items: [stops[2]] },
    ];
  }
  const morningEnd = 2;
  const eveningStart = n - 1;
  return [
    { label: 'Mattino', items: stops.slice(0, morningEnd) },
    { label: 'Pomeriggio', items: stops.slice(morningEnd, eveningStart) },
    { label: 'Sera', items: stops.slice(eveningStart) },
  ];
}

const slots = groupStops(stops);
---

<div class="timeline relative" style={`--day-color: ${color};`}>
  <div class="timeline-line" aria-hidden="true"></div>

  <ol class="space-y-10">
    {slots.map((slot) => (
      <li>
        <header class="timeline-slot-header mb-4 flex items-center gap-3 md:pl-16">
          <span
            class="timeline-dot relative z-10 inline-flex h-5 w-5 items-center justify-center rounded-full md:absolute md:left-[26px]"
            style={`background-color: ${color};`}
            aria-hidden="true"
          >
            <span class="absolute inset-0 rounded-full opacity-40 blur-sm" style={`background-color: ${color};`}></span>
          </span>
          <h3 class="font-[var(--font-display)] text-2xl font-semibold text-[var(--color-iznik-dark)]">
            {slot.label}
          </h3>
        </header>

        <div class="grid grid-cols-1 gap-5 md:ml-16 md:grid-cols-2">
          {slot.items.map((stop) => (
            <AttractionCard attraction={stop} dayColor={color} />
          ))}
        </div>
      </li>
    ))}
  </ol>
</div>

<style>
  .timeline {
    position: relative;
  }
  .timeline-line {
    display: none;
  }
  @media (min-width: 768px) {
    .timeline-line {
      display: block;
      position: absolute;
      left: 34px;
      top: 8px;
      bottom: 8px;
      width: 2px;
      background: linear-gradient(to bottom, var(--day-color), color-mix(in oklab, var(--day-color) 40%, transparent));
      border-radius: 2px;
    }
  }
</style>
