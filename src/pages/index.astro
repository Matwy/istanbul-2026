---
import Base from '@/layouts/Base.astro';
import Card from '@/components/ui/Card.astro';
import Countdown from '@/components/Countdown.svelte';
import { HOME_CARDS, QUICK_INFO, TRIP } from '@/lib/constants.ts';

const iconMap: Record<string, string> = {
  'calendar-days': '<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line><path d="M8 14h.01"></path><path d="M12 14h.01"></path><path d="M16 14h.01"></path><path d="M8 18h.01"></path><path d="M12 18h.01"></path>',
  'map': '<polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon><line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line>',
  'check-square': '<polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>',
  'utensils': '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"></path><line x1="7" y1="2" x2="7" y2="22"></line><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Z"></path><line x1="18" y1="15" x2="18" y2="22"></line>',
  'building-2': '<path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"></path><path d="M6 12H4a2 2 0 0 0-2 2v8h4"></path><path d="M18 9h2a2 2 0 0 1 2 2v11h-4"></path><path d="M10 6h4"></path><path d="M10 10h4"></path><path d="M10 14h4"></path><path d="M10 18h4"></path>',
  'bus': '<path d="M8 6v6"></path><path d="M16 6v6"></path><path d="M2 12h20"></path><path d="M18 18h2a2 2 0 0 0 2-2v-6a8 8 0 0 0-16 0v6a2 2 0 0 0 2 2h2"></path><circle cx="7" cy="18" r="2"></circle><path d="M9 18h6"></path><circle cx="17" cy="18" r="2"></circle>',
};
---

<Base heroTone="iznik">
  <section class="hero relative isolate overflow-hidden">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-pattern" aria-hidden="true"></div>

    <div class="relative mx-auto flex max-w-5xl flex-col items-center gap-8 px-4 pt-20 pb-24 text-center md:pt-32 md:pb-32">
      <p class="font-[var(--font-sans)] text-xs font-medium uppercase tracking-[0.35em] text-[var(--color-gold)]">
        Gita di famiglia
      </p>
      <h1 class="font-[var(--font-display)] text-6xl font-semibold leading-[0.95] text-[var(--color-paper)] text-balance sm:text-7xl md:text-8xl lg:text-[9rem]">
        Istanbul
      </h1>
      <p class="max-w-xl text-lg text-[color-mix(in_oklab,var(--color-paper)_85%,transparent)] md:text-xl text-balance">
        {TRIP.subtitle}
      </p>
      <div class="mt-4">
        <Countdown client:load />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
    <header class="mb-8 md:mb-12">
      <h2 class="font-[var(--font-display)] text-3xl font-semibold md:text-4xl">
        Naviga il viaggio
      </h2>
      <p class="mt-2 max-w-2xl text-[var(--color-ink-soft)]">
        Cinque giorni, sei sezioni. Tutto quello che serve per vivere la città senza perdere tempo.
      </p>
    </header>

    <div class="home-grid grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {HOME_CARDS.map((c) => (
        <Card href={c.href} class="home-card p-6">
          <div class="flex items-start gap-4">
            <span
              class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[color-mix(in_oklab,var(--color-iznik)_10%,transparent)] text-[var(--color-iznik)] transition-colors group-hover:bg-[var(--color-iznik)] group-hover:text-[var(--color-gold-bright)]"
              aria-hidden="true"
            >
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={iconMap[c.icon] ?? ''}></svg>
            </span>
            <div class="flex-1">
              <h3 class="font-[var(--font-display)] text-xl font-semibold text-[var(--color-iznik-dark)] leading-snug">
                {c.title}
              </h3>
              <p class="mt-1.5 text-sm text-[var(--color-ink-soft)]">
                {c.description}
              </p>
            </div>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 text-[var(--color-ink-faint)] transition-all group-hover:translate-x-1 group-hover:text-[var(--color-gold)]">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </Card>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
    <header class="mb-8 md:mb-12">
      <h2 class="font-[var(--font-display)] text-3xl font-semibold md:text-4xl">
        Info rapide
      </h2>
      <p class="mt-2 text-[var(--color-ink-soft)]">
        L'essenziale da sapere prima di partire.
      </p>
    </header>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {QUICK_INFO.map((info) => (
        <div class="rounded-[var(--radius-card)] border border-[color-mix(in_oklab,var(--color-iznik)_10%,transparent)] bg-[var(--color-paper)] p-5 shadow-[var(--shadow-card)]">
          <dt class="text-xs font-medium uppercase tracking-wider text-[var(--color-gold-deep)]">
            {info.label}
          </dt>
          <dd class="mt-1 font-[var(--font-display)] text-xl font-semibold text-[var(--color-iznik-dark)]">
            {info.value}
          </dd>
          <p class="mt-1 text-sm text-[var(--color-ink-soft)]">{info.note}</p>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero {
    background-color: var(--color-iznik-dark);
    color: var(--color-paper);
    min-height: calc(100dvh - 64px);
    display: flex;
    align-items: center;
    margin-top: -64px;
    padding-top: 64px;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 20% 10%, color-mix(in oklab, var(--color-iznik-soft) 60%, transparent) 0%, transparent 55%),
      radial-gradient(ellipse at 80% 90%, color-mix(in oklab, var(--color-gold) 35%, transparent) 0%, transparent 60%),
      linear-gradient(180deg, var(--color-iznik-dark) 0%, var(--color-iznik) 100%);
    z-index: -2;
  }
  .hero-pattern {
    position: absolute;
    inset: 0;
    background-image: url('/patterns/stella-8.svg');
    background-size: 180px 180px;
    opacity: 0.15;
    z-index: -1;
    mix-blend-mode: overlay;
  }
</style>

<script>
  async function initHomeAnimations() {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;
    const { animate, inView, stagger } = await import('motion');
    const cards = document.querySelectorAll<HTMLElement>('.home-card');
    if (cards.length > 0) {
      cards.forEach((el) => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(18px)';
      });
      inView(
        '.home-grid',
        () => {
          animate(
            '.home-card',
            { opacity: [0, 1], transform: ['translateY(18px)', 'translateY(0px)'] },
            { duration: 0.6, delay: stagger(0.07), easing: [0.22, 1, 0.36, 1] }
          );
        },
        { amount: 0.15 }
      );
    }
  }

  initHomeAnimations();
  document.addEventListener('astro:page-load', initHomeAnimations);
</script>
