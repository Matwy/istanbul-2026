---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Card from '@/components/ui/Card.astro';
import Chip from '@/components/ui/Chip.astro';

const neighborhoods = (await getCollection('neighborhoods')).sort((a, b) => a.data.order - b.data.order);
const europeans = neighborhoods.filter((n) => n.data.side === 'europea');
const asians = neighborhoods.filter((n) => n.data.side === 'asiatica');
---

<Base
  title="Quartieri"
  description="Le 8 zone da scoprire a Istanbul tra lato europeo e lato asiatico."
>
  <section class="mx-auto max-w-6xl px-4 pt-12 pb-8 md:px-6 md:pt-16">
    <header class="max-w-2xl">
      <p class="text-xs font-medium uppercase tracking-[0.25em] text-[var(--color-gold-deep)]">
        Due continenti, una città
      </p>
      <h1 class="mt-2 font-[var(--font-display)] text-5xl font-semibold text-[var(--color-iznik-dark)] md:text-6xl">
        Quartieri
      </h1>
      <p class="mt-3 text-[var(--color-ink-soft)]">
        Istanbul si divide sul Bosforo. Ogni quartiere ha il suo carattere: storico, bohémien, chic, popolare.
      </p>
    </header>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-10 md:px-6">
    <header class="mb-6 flex items-center gap-3">
      <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-[color-mix(in_oklab,var(--color-iznik)_12%,transparent)] text-[var(--color-iznik)]" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 10c0 7-8 13-8 13s-8-6-8-13a8 8 0 0 1 16 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
      </span>
      <h2 class="font-[var(--font-display)] text-3xl font-semibold text-[var(--color-iznik-dark)] md:text-4xl">
        Lato europeo <span class="text-base font-normal text-[var(--color-ink-faint)]">· {europeans.length} quartieri</span>
      </h2>
    </header>
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      {europeans.map((n) => (
        <Card class="flex h-full flex-col gap-3 p-6">
          <div class="flex items-start justify-between gap-3">
            <h3 class="font-[var(--font-display)] text-2xl font-semibold text-[var(--color-iznik-dark)]">
              {n.data.name}
            </h3>
            <span class="mt-1 inline-flex shrink-0 items-center gap-1 rounded-full bg-[color-mix(in_oklab,var(--color-iznik)_10%,transparent)] px-2.5 py-1 text-xs font-medium text-[var(--color-iznik)]">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 7-8 13-8 13s-8-6-8-13a8 8 0 0 1 16 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              Europa
            </span>
          </div>
          <p class="text-sm text-[var(--color-ink-soft)] text-pretty">{n.data.description}</p>
          <div class="mt-auto flex flex-wrap gap-1.5 pt-2">
            {n.data.tags.map((t, i) => {
              const variants = ['iznik', 'gold', 'neutral'] as const;
              return <Chip variant={variants[i % variants.length]}>{t}</Chip>;
            })}
          </div>
        </Card>
      ))}
    </div>
  </section>

  <div class="divider-ornament mx-auto my-6 max-w-3xl px-6" aria-hidden="true">
    <img src="/patterns/divider.svg" alt="" width="72" height="16" loading="lazy" />
  </div>

  <section class="mx-auto max-w-6xl px-4 pb-16 md:px-6">
    <header class="mb-6 flex items-center gap-3">
      <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-[color-mix(in_oklab,var(--color-garnet)_12%,transparent)] text-[var(--color-garnet)]" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 10c0 7-8 13-8 13s-8-6-8-13a8 8 0 0 1 16 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
      </span>
      <h2 class="font-[var(--font-display)] text-3xl font-semibold text-[var(--color-iznik-dark)] md:text-4xl">
        Lato asiatico <span class="text-base font-normal text-[var(--color-ink-faint)]">· {asians.length} quartieri</span>
      </h2>
    </header>
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      {asians.map((n) => (
        <Card class="flex h-full flex-col gap-3 p-6">
          <div class="flex items-start justify-between gap-3">
            <h3 class="font-[var(--font-display)] text-2xl font-semibold text-[var(--color-iznik-dark)]">
              {n.data.name}
            </h3>
            <span class="mt-1 inline-flex shrink-0 items-center gap-1 rounded-full bg-[color-mix(in_oklab,var(--color-garnet)_10%,transparent)] px-2.5 py-1 text-xs font-medium text-[var(--color-garnet)]">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 7-8 13-8 13s-8-6-8-13a8 8 0 0 1 16 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              Asia
            </span>
          </div>
          <p class="text-sm text-[var(--color-ink-soft)] text-pretty">{n.data.description}</p>
          <div class="mt-auto flex flex-wrap gap-1.5 pt-2">
            {n.data.tags.map((t, i) => {
              const variants = ['garnet', 'gold', 'neutral'] as const;
              return <Chip variant={variants[i % variants.length]}>{t}</Chip>;
            })}
          </div>
        </Card>
      ))}
    </div>
  </section>
</Base>
