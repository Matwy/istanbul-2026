---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import FullMap from '@/components/FullMap.svelte';
import { buildGoogleMapsUrl, DAY_COLORS } from '@/lib/map-utils.ts';

const attractions = await getCollection('attractions');
const days = (await getCollection('days')).sort((a, b) => a.data.order - b.data.order);

const points = attractions.map((a) => ({
  lat: a.data.lat,
  lng: a.data.lng,
  name: a.data.name,
  id: a.id,
  dayId: (a.data.dayId ?? 'optional') as string,
  googleMapsUrl: buildGoogleMapsUrl(a.data.lat, a.data.lng, a.data.name),
}));

const byDay = days.map((d) => ({
  id: d.id,
  order: d.data.order,
  title: d.data.title,
  color: d.data.color,
  items: attractions.filter((a) => a.data.dayId === d.id),
}));
const optionalItems = attractions.filter((a) => !a.data.dayId);
---

<Base
  title="Mappa generale"
  description="Tutte le attrazioni del viaggio a Istanbul su un'unica mappa interattiva, filtrabili per giorno."
>
  <section class="mx-auto max-w-6xl px-4 pt-12 pb-6 md:px-6 md:pt-16">
    <header class="max-w-2xl">
      <p class="text-xs font-medium uppercase tracking-[0.25em] text-[var(--color-gold-deep)]">
        Tutti i punti
      </p>
      <h1 class="mt-2 font-[var(--font-display)] text-5xl font-semibold text-[var(--color-iznik-dark)] md:text-6xl">
        Mappa generale
      </h1>
      <p class="mt-3 text-[var(--color-ink-soft)]">
        Le {attractions.length} tappe del viaggio, colorate per giorno. Clicca sui pin per dettagli e link a Google Maps.
      </p>
    </header>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 md:px-6">
    <div class="overflow-hidden rounded-[var(--radius-card)] border border-[color-mix(in_oklab,var(--color-iznik)_10%,transparent)] shadow-[var(--shadow-card)]">
      <FullMap client:visible points={points} dayColors={DAY_COLORS} />
    </div>

    <noscript>
      <div class="mt-8 space-y-6">
        {byDay.map((d) => d.items.length > 0 && (
          <div>
            <h2 class="font-[var(--font-display)] text-2xl font-semibold" style={`color: ${d.color};`}>
              Giorno {d.order} · {d.title}
            </h2>
            <ul class="mt-2 space-y-1 pl-5 list-disc">
              {d.items.map((a) => (
                <li>
                  <a href={buildGoogleMapsUrl(a.data.lat, a.data.lng, a.data.name)} target="_blank" rel="noopener noreferrer" class="underline">
                    {a.data.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
        {optionalItems.length > 0 && (
          <div>
            <h2 class="font-[var(--font-display)] text-2xl font-semibold text-[var(--color-ink-soft)]">
              Opzionali
            </h2>
            <ul class="mt-2 space-y-1 pl-5 list-disc">
              {optionalItems.map((a) => (
                <li>
                  <a href={buildGoogleMapsUrl(a.data.lat, a.data.lng, a.data.name)} target="_blank" rel="noopener noreferrer" class="underline">
                    {a.data.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </noscript>
  </section>
</Base>
