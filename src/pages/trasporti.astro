---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Card from '@/components/ui/Card.astro';
import Chip from '@/components/ui/Chip.astro';
import CurrencyCalculator from '@/components/CurrencyCalculator.svelte';
import TransportCalculator from '@/components/TransportCalculator.svelte';
import { ISTANBULKART } from '@/lib/constants.ts';

const transports = (await getCollection('transports')).sort((a, b) => a.data.order - b.data.order);

const iconMap: Record<string, string> = {
  tram: '<rect x="4" y="3" width="16" height="16" rx="2"></rect><line x1="4" y1="11" x2="20" y2="11"></line><circle cx="8" cy="15" r="1.5"></circle><circle cx="16" cy="15" r="1.5"></circle><line x1="8" y1="19" x2="6" y2="22"></line><line x1="16" y1="19" x2="18" y2="22"></line>',
  metro: '<rect x="4" y="3" width="16" height="16" rx="2"></rect><path d="M9 9l3 6l3-6"></path><line x1="8" y1="19" x2="6" y2="22"></line><line x1="16" y1="19" x2="18" y2="22"></line>',
  ferry: '<path d="M3 18l2-6h14l2 6"></path><path d="M5 12l7-6l7 6"></path><path d="M2 20c2 1 3 1 5 0s3-1 5 0s3 1 5 0s3-1 5 0"></path>',
  bus: '<path d="M8 6v6"></path><path d="M16 6v6"></path><path d="M2 12h20"></path><path d="M18 18h2a2 2 0 0 0 2-2v-6a8 8 0 0 0-16 0v6a2 2 0 0 0 2 2h2"></path><circle cx="7" cy="18" r="2"></circle><path d="M9 18h6"></path><circle cx="17" cy="18" r="2"></circle>',
  funicular: '<path d="M4 20L20 4"></path><rect x="6" y="13" width="8" height="6" rx="1" transform="rotate(-45 10 16)"></rect><circle cx="8" cy="18" r="1"></circle><circle cx="12" cy="14" r="1"></circle>',
  taxi: '<rect x="3" y="10" width="18" height="8" rx="2"></rect><path d="M6 10V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v4"></path><circle cx="7" cy="18" r="1.5"></circle><circle cx="17" cy="18" r="1.5"></circle><rect x="9" y="5" width="6" height="2"></rect>',
};

const fallbackIcon = '<circle cx="12" cy="12" r="9"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line>';
---

<Base
  title="Trasporti"
  description="Come muoversi a Istanbul: mezzi pubblici, Istanbulkart, calcolatori di spesa e conversione euro-lira turca."
>
  <section class="mx-auto max-w-6xl px-4 pt-12 pb-8 md:px-6 md:pt-16">
    <header class="max-w-2xl">
      <p class="text-xs font-medium uppercase tracking-[0.25em] text-[var(--color-gold-deep)]">
        Muoversi in città
      </p>
      <h1 class="mt-2 font-[var(--font-display)] text-5xl font-semibold text-[var(--color-iznik-dark)] md:text-6xl">
        Trasporti
      </h1>
      <p class="mt-3 text-[var(--color-ink-soft)]">
        Istanbul è grande ma ben collegata. La Istanbulkart è la chiave di tutto.
      </p>
    </header>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-8 md:px-6">
    <h2 class="mb-6 font-[var(--font-display)] text-3xl font-semibold text-[var(--color-iznik-dark)] md:text-4xl">
      Muoversi a Istanbul
    </h2>
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
      {transports.map((t) => (
        <Card class="flex h-full flex-col gap-3 p-6">
          <div class="flex items-center gap-3">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-[color-mix(in_oklab,var(--color-iznik)_10%,transparent)] text-[var(--color-iznik)]" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={iconMap[t.data.icon] ?? fallbackIcon}></svg>
            </span>
            <div>
              <h3 class="font-[var(--font-display)] text-xl font-semibold text-[var(--color-iznik-dark)] leading-tight">
                {t.data.name}
              </h3>
              {t.data.turkishName && (
                <p class="text-xs italic text-[var(--color-ink-faint)]">{t.data.turkishName}</p>
              )}
            </div>
          </div>
          <p class="text-sm text-[var(--color-ink-soft)] text-pretty">{t.data.description}</p>
          <div class="mt-auto rounded-lg bg-[var(--color-cream)] p-3 text-xs leading-relaxed text-[var(--color-ink-soft)]">
            <span class="font-semibold text-[var(--color-iznik)]">Tip: </span>
            {t.data.tips}
          </div>
        </Card>
      ))}
    </div>
  </section>

  <div class="divider-ornament mx-auto my-10 max-w-3xl px-6" aria-hidden="true">
    <img src="/patterns/divider.svg" alt="" width="72" height="16" loading="lazy" />
  </div>

  <section class="mx-auto max-w-6xl px-4 py-8 md:px-6">
    <div class="overflow-hidden rounded-[var(--radius-card)] border border-[color-mix(in_oklab,var(--color-gold)_25%,transparent)] bg-gradient-to-br from-[var(--color-paper)] to-[color-mix(in_oklab,var(--color-gold)_10%,var(--color-paper))] shadow-[var(--shadow-card)]">
      <div class="p-6 md:p-10">
        <div class="flex items-start gap-4">
          <span class="inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-[var(--color-gold)] text-[var(--color-iznik-dark)]" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="5" width="20" height="14" rx="2"></rect>
              <line x1="2" y1="10" x2="22" y2="10"></line>
            </svg>
          </span>
          <div>
            <h2 class="font-[var(--font-display)] text-3xl font-semibold text-[var(--color-iznik-dark)] md:text-4xl">
              Istanbulkart
            </h2>
            <p class="mt-1 text-[var(--color-ink-soft)]">
              La carta ricaricabile per tutti i mezzi. Conveniente, necessaria, condivisibile in famiglia.
            </p>
          </div>
        </div>

        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
          <div class="rounded-xl bg-[var(--color-paper)] p-5 shadow-[var(--shadow-card)]">
            <p class="text-xs font-medium uppercase tracking-wider text-[var(--color-gold-deep)]">Carta</p>
            <p class="mt-1 font-[var(--font-display)] text-3xl font-semibold text-[var(--color-iznik-dark)]">
              {ISTANBULKART.cardCost} TL
            </p>
            <p class="text-xs text-[var(--color-ink-faint)]">≈ {ISTANBULKART.cardCostEur.toFixed(2)} €</p>
            <p class="mt-2 text-xs text-[var(--color-ink-soft)]">Costo carta (una tantum).</p>
          </div>
          <div class="rounded-xl bg-[var(--color-paper)] p-5 shadow-[var(--shadow-card)]">
            <p class="text-xs font-medium uppercase tracking-wider text-[var(--color-gold-deep)]">Per corsa</p>
            <p class="mt-1 font-[var(--font-display)] text-3xl font-semibold text-[var(--color-iznik-dark)]">
              {ISTANBULKART.perRide} TL
            </p>
            <p class="text-xs text-[var(--color-ink-faint)]">≈ {ISTANBULKART.perRideEur.toFixed(2)} €</p>
            <p class="mt-2 text-xs text-[var(--color-ink-soft)]">Tariffa singola con carta ricaricata.</p>
          </div>
          <div class="rounded-xl bg-[var(--color-paper)] p-5 shadow-[var(--shadow-card)]">
            <p class="text-xs font-medium uppercase tracking-wider text-[var(--color-gold-deep)]">Senza carta</p>
            <p class="mt-1 font-[var(--font-display)] text-3xl font-semibold text-[var(--color-iznik-dark)]">
              {ISTANBULKART.singleRide} TL
            </p>
            <p class="text-xs text-[var(--color-ink-faint)]">≈ {ISTANBULKART.singleRideEur.toFixed(2)} €</p>
            <p class="mt-2 text-xs text-[var(--color-ink-soft)]">Biglietto singolo (più caro).</p>
          </div>
        </div>

        <div class="mt-8">
          <h3 class="font-[var(--font-display)] text-xl font-semibold text-[var(--color-iznik-dark)]">
            Tabella biglietti singoli
          </h3>
          <div class="mt-3 overflow-x-auto">
            <table class="w-full min-w-[320px] text-sm">
              <thead>
                <tr class="border-b border-[color-mix(in_oklab,var(--color-iznik)_15%,transparent)] text-[var(--color-ink-soft)]">
                  <th class="py-2 text-left font-medium">Corse</th>
                  <th class="py-2 text-right font-medium">TL</th>
                  <th class="py-2 text-right font-medium">€</th>
                </tr>
              </thead>
              <tbody>
                {ISTANBULKART.singleTable.map((row, i) => (
                  <tr class:list={['border-b border-[color-mix(in_oklab,var(--color-iznik)_8%,transparent)]', i % 2 === 1 && 'bg-[color-mix(in_oklab,var(--color-iznik)_3%,transparent)]']}>
                    <td class="py-2 font-medium text-[var(--color-iznik-dark)]">{row.rides}</td>
                    <td class="py-2 text-right">{row.tl}</td>
                    <td class="py-2 text-right text-[var(--color-ink-soft)]">{row.eur.toFixed(2)} €</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap gap-2">
          <Chip variant="garnet">Attenzione: carte rosse in vendita nei bazar sono contraffatte</Chip>
          <Chip variant="gold">Acquista solo ai distributori ufficiali</Chip>
          <Chip variant="iznik">Condivisibile in famiglia</Chip>
        </div>
      </div>
    </div>
  </section>

  <div class="divider-ornament mx-auto my-10 max-w-3xl px-6" aria-hidden="true">
    <img src="/patterns/divider.svg" alt="" width="72" height="16" loading="lazy" />
  </div>

  <section class="mx-auto max-w-6xl px-4 pb-16 md:px-6">
    <h2 class="mb-6 font-[var(--font-display)] text-3xl font-semibold text-[var(--color-iznik-dark)] md:text-4xl">
      Calcolatori
    </h2>
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <CurrencyCalculator client:load />
      <TransportCalculator client:load />
    </div>
  </section>
</Base>
